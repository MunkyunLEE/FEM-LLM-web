     "plane": {
      "axis": "x",
      "at": "min"
     }
    }
   },
   {
    "op": "add_bc",
    "name": "강체 이동 방지 y",
    "dofs": [
     2
    ],
    "select": {
     "and": [
      {
       "plane": {
        "axis": "x",
        "at": "min"
