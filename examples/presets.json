{
 "cantilever_beam": {
  "title": "1. 직사각 단면 캔틸레버 빔 (보 요소)",
  "file": "cantilever_beam.obj",
  "note": "L=1000, 단면 b50 x h100, 끝단 -1000 N. 이론 처짐 PL^3/3EI = 0.381 mm",
  "prompts": [
   "x 최소인 끝을 완전 고정해줘",
   "x 최대 끝단에 z 방향으로 -1000 N 하중 줘",
   "끝단 처짐을 하중계수에 대해 그래프로 그려줘"
  ],
  "ops": [
   {
    "op": "set_solver",
    "solver": "calculix"
   },
   {
    "op": "set_section",
    "group": "*",
    "beam": {
     "shape": "rect",
     "b": 50,
     "h": 100
    }
   },
   {
    "op": "add_bc",
    "type": "fixed",
    "name": "고정단",
    "select": {
     "plane": {
      "axis": "x",
      "at": "min"
     }
    }
   },
   {
    "op": "add_load",
    "type": "force",
    "name": "끝단 하중",
    "vector": [
     0,
     0,
     -1000
    ],
    "select": {
     "plane": {
      "axis": "x",
      "at": "max"
     }
    }
   }
  ]
 },
 "shell_panel": {
  "title": "2. 정사각형 쉘 패널 엣지 압축 (좌굴)",
  "file": "shell_panel.obj",
  "note": "200x200, t=2, 네 변 단순지지, x 방향 압축 1000 N. 이론 좌굴하중 4*pi^2*D/b = 30.37 kN (계수 30.4)",
  "prompts": [
   "네 변 모두 z 방향만 구속해줘",
   "x 최소 변을 x 방향 구속해줘",
   "절점 (0, 0, 0) 을 y 방향 구속해줘",
   "x 최대 변에 x 방향으로 -1000 N 압축 하중",
   "좌굴 해석으로 바꾸고 모드 4개"
  ],
  "ops": [
   {
    "op": "set_solver",
    "solver": "calculix"
   },
   {
    "op": "set_section",
    "group": "*",
    "thickness": 2.0
   },
   {
    "op": "add_bc",
    "name": "네 변 z 지지",
    "dofs": [
     3
    ],
    "select": {
     "or": [
      {
       "plane": {
        "axis": "x",
        "at": "min"
       }
      },
      {
       "plane": {
        "axis": "x",
        "at": "max"
       }
      },
      {
       "plane": {
        "axis": "y",
        "at": "min"
       }
      },
      {
       "plane": {
        "axis": "y",
        "at": "max"
       }
      }
     ]
    }
   },
   {
    "op": "add_bc",
    "name": "x 최소 변 x 구속",
    "dofs": [
     1
    ],
    "select": {
     "plane": {
      "axis": "x",
      "at": "min"
     }
    }
   },
   {
    "op": "add_bc",
    "name": "강체 이동 방지 y",
    "dofs": [
     2
    ],
    "select": {
     "and": [
      {
       "plane": {
        "axis": "x",
        "at": "min"
       }
      },
      {
       "plane": {
        "axis": "y",
        "at": "min"
       }
      }
     ]
    }
   },
   {
    "op": "add_load",
    "type": "force",
    "name": "엣지 압축",
    "vector": [
     -1000,
     0,
     0
    ],
    "select": {
     "plane": {
      "axis": "x",
      "at": "max"
     }
    }
   },
   {
    "op": "set_step",
    "type": "buckle",
    "modes": 4
   }
  ]
 },
