 "miura": {
  "title": "4. 미우라 오리 1자유도 접힘 (바-힌지)",
  "file": "miura.obj",
  "note": "a=b=50, gamma=60도, 초기 접힘각 60도, 4x4 패널, t=0.5. 힌지 강성 kappa = 0.1 x D / L",
  "prompts": [
   "x 최소 쪽 절점들을 x 방향 구속해줘",
   "x 최대 쪽 절점들을 x 방향으로 -30 mm 밀어줘",
   "시간-총에너지 그래프 그려줘"
  ],
  "ops": [
   {
    "op": "set_solver",
    "solver": "barhinge"
   },
   {
    "op": "set_section",
    "group": "*",
    "thickness": 0.5
   },
   {
    "op": "set_material",
    "name": "default",
    "E": 3000,
    "nu": 0.3,
    "rho": 1.2e-09
   },
   {
    "op": "set_hinge",
    "group": "*",
    "kappa": null,
    "ratio": 0.1
   },
   {
    "op": "add_bc",
    "name": "x 최소 변 x 구속",
    "dofs": [
     1
    ],
    "select": {
     "plane": {
      "axis": "x",
      "at": "min"
     }
    }
   },
   {
    "op": "add_bc",
    "name": "기준점 y z 구속",
    "dofs": [
     2,
     3
    ],
    "select": {
     "nearest": [
      0,
      0,
      0
     ]
    }
   },
   {
    "op": "add_bc",
    "name": "회전 방지 z",
    "dofs": [
     3
    ],
    "select": {
     "and": [
      {
       "plane": {
        "axis": "x",
        "at": "min"
       }
      },
      {
       "plane": {
        "axis": "z",
        "at": "min"
       }
      }
     ]
    }
   },
   {
    "op": "add_bc",
    "name": "x 최대 변 강제 변위",
    "dofs": [
     1
    ],
    "value": -30.0,
    "select": {
     "plane": {
      "axis": "x",
      "at": "max"
     }
    }
   },
   {
    "op": "set_step",
    "type": "static",
    "nlgeom": true,
    "increments": 30
   },
   {
    "op": "add_plot",
    "title": "에너지 이력",
    "x": {
     "quantity": "time"
    },
    "series": [
     {
      "quantity": "energy.total"
     },
     {
      "quantity": "energy.fold"
     },
     {
      "quantity": "energy.bar"
     },
     {
      "quantity": "energy.bend"
     }
    ]
   }
  ]
 },
